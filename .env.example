# Set these via Sites environment settings for the hosted application.
# Only this exact signed-in email can establish the first administrator.
ADMIN_EMAIL=
# Optional: AI generation is unavailable until both values are configured.
OPENAI_API_KEY=
OPENAI_MODEL=

# Operator-only Google OAuth provisioning (scripts/configure-google-auth.mjs).
# These are NOT frontend variables and are never bundled with the portal.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
